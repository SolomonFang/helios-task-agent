# ---- LLM (OpenAI 兼容协议，必填) ----
# Kimi Coding（sk-kimi-… 密钥）：https://api.kimi.com/coding/v1
# Kimi/Moonshot 国内版：https://api.moonshot.cn/v1
# Kimi/Moonshot 国际版：https://api.moonshot.ai/v1
# OpenAI：https://api.openai.com/v1
# DeepSeek：https://api.deepseek.com/v1
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=kimi-k2-0905-preview
# 图片消息（vision）开关：设为 1 后，私聊图片会下载并以 base64 送入 LLM（需模型支持图片输入）；
# 默认关闭，图片消息仍回复「暂只支持文字消息」
# LLM_VISION=0

# ---- helios-kanban (可选) ----
# MCP 模式命令（以下为代码内置默认值，一般无需配置；包规格默认跟随 @latest——
# 需钉版本时用下方 HELIOS_KANBAN_PACKAGE 指定，如 helios-kanban@x.y.z）
# HELIOS_KANBAN_MCP_COMMAND=npx
# HELIOS_KANBAN_MCP_ARGS=-y helios-kanban@latest --mcp
# 自动拉起 / MCP 默认使用的 helios-kanban 包规格（默认跟随 @latest；需钉版本时指定，如 helios-kanban@x.y.z）
# HELIOS_KANBAN_PACKAGE=helios-kanban@latest
# HTTP 降级 / hk.sh 使用
HELIOS_KANBAN_URL=http://localhost:7964
# 本机未运行看板时，初始化自动 npx 拉起（设为 0 关闭）
# HELIOS_KANBAN_AUTO_START=1
# 自动拉起看板的监听地址（看板 Web/API 无鉴权，默认仅回环；谨慎改为 0.0.0.0）
# HELIOS_KANBAN_HOST=127.0.0.1
# 报告静态服务的监听地址（AI 审查/工作总结报告含代码 diff，默认仅回环，不跟随 HELIOS_KANBAN_HOST；
# 报告 URL 已带随机 token 防猜，但确需局域网访问时才显式改为 0.0.0.0）
# HELIOS_REPORT_HOST=127.0.0.1
# 默认项目 / 仓库 / 迭代（可选，不填则由助手先列出可选项再选择）
# HELIOS_KANBAN_PROJECT_ID=
# HELIOS_KANBAN_REPO_ID=
# HELIOS_KANBAN_ITERATION=

# ---- Agent 数据目录（可选）----
# 默认配置与记忆：~/.helios-task-agent/（安装后直接 helios-task-agent bot 走向导即可，无需手写本文件）
# HELIOS_TASK_AGENT_HOME=
# 强制指定 .env 路径（向导写入目标）
# HELIOS_TASK_AGENT_ENV=

# ---- 飞书机器人长连接 ----
# 启动：helios-task-agent bot   （缺配置会交互向导，不必手写）
# 开放平台：启用机器人 → 事件订阅选「长连接」→ 订阅 im.message.receive_v1
# 可选（确认卡片按钮）：回调订阅选「长连接」→ 添加「卡片回传交互」(card.action.trigger)
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# 留空 = 首个私聊用户自动成为 owner 并写回白名单（先聊先得：机器人可被他人搜到时
# 存在被抢占风险，建议显式配置）；填了则仅列表内用户可用
# FEISHU_ALLOWED_OPEN_IDS=ou_xxx

# ---- 看板状态推送（bot 模式，可选）----
# 任务完成/失败、新待审批 → 主动推送飞书（推给白名单用户；同时注入会话上下文可直接追问）
# KANBAN_WATCH=1              默认开启；设为 0 关闭
# KANBAN_WATCH_INTERVAL_SEC=60  轮询间隔（秒，最小 15）

# ---- 定时晨报（bot 模式，可选）----
# 每天到点给白名单用户（owner）推一条当前迭代的任务概览（进行中/待审阅/已完成/失败的数量与标题清单；
# HELIOS_KANBAN_ITERATION 未配置时范围为全部迭代）。
# 本地时间 HH:MM（如 09:30）；未设置或非法 = 关闭（默认关）。看板不可达/推送失败时跳过本次，
# 按 1→2→4…分钟退避重试（封顶 30 分钟），当天内有效；推送过的日期落盘，重启当天不重复推。
# HTA_DAILY_BRIEF=09:30

# ---- AI 审查（bot 模式，可选）----
# 待审阅卡片的「AI 审查」调用 open-code-review（代码审查工具，命令名 `ocr`）；未安装时 npx 拉取（钉版本，首次较慢）
# OCR_PACKAGE=@alibaba-group/open-code-review@1.8.0
# OCR 使用的模型：默认复用上方 LLM_*，派生为 OCR_LLM_URL / OCR_LLM_TOKEN / OCR_LLM_MODEL
# 传给 ocr 子进程（即 ocr 会拿到你的 LLM key）；显式设置 OCR_LLM_URL 或已有
# ~/.opencodereview/config.json 时优先用你的配置，不再注入派生副本；
# 只想隔离 key 时设置专用 OCR_LLM_TOKEN（优先于主 key 派生，URL/模型仍回退上方配置）
# OCR_LLM_URL=
# OCR_LLM_TOKEN=
# OCR_LLM_MODEL=

# ---- Agent 行为（可选）----
# 单轮对话的墙钟时间上限（分钟）：超时按「已中止」收尾并提示，默认 30
# HTA_TURN_TIMEOUT_MIN=30

# ---- 调试（可选）----
# 设为 1 时输出 kanban 子进程 / MCP 调试日志
# HTA_DEBUG=0

# ---- 启动更新检查（可选）----
# 启动时检查 npm 上的新版本并请示是否更新（结果缓存 24h，离线自动跳过）
# HTA_UPDATE_CHECK=1           默认开启；设为 0 关闭
# HTA_UPDATE_REGISTRY=         默认跟随 npm config get registry（含镜像）
