{
  "name": "helios-task-agent",
  "version": "1.0.12",
  "description": "Terminal agent that turns Lark/Feishu content into helios-kanban tasks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "helios-task-agent": "bin/helios-task-agent.js",
    "helios-task-agent-bot": "bin/helios-task-agent-bot.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "tsx scripts/unit.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:e2e": "tsx scripts/e2e-mock.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm test && npm run smoke && npm run test:e2e",
    "prepublishOnly": "npm run typecheck",
    "bot": "tsx src/bot.ts"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    ".env.example",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "!dist/**/*.map"
  ],
  "keywords": [
    "helios-kanban",
    "lark",
    "feishu",
    "agent",
    "mcp"
  ],
  "author": "qiang.fang",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolomonFang/helios-task-agent.git"
  },
  "bugs": {
    "url": "https://github.com/SolomonFang/helios-task-agent/issues"
  },
  "homepage": "https://github.com/SolomonFang/helios-task-agent#readme",
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.4.5",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
